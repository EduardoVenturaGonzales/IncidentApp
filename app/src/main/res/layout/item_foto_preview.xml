<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="108dp"
    android:layout_height="108dp"
    android:layout_marginEnd="10dp">

    <ImageView
        android:id="@+id/ivFotoPreview"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="bottom|start"
        android:background="@drawable/bg_image_preview"
        android:clipToOutline="true"
        android:contentDescription="Vista previa de la foto del incidente"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/btnEliminarFoto"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="top|end"
        android:background="@drawable/bg_remove_photo"
        android:clickable="true"
        android:contentDescription="Quitar foto"
        android:elevation="6dp"
        android:focusable="true"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="−"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold" />

</FrameLayout>
